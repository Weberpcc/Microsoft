# SEO-Mind Configuration Environment Variables

# Backend Service
PORT=8000
HOST=0.0.0.0
DEBUG=True
PROJECT_NAME="SEO-Mind"
API_V1_STR="/api/v1"

# Security & JWT
SECRET_KEY="seo-mind-super-secret-key-change-this-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=seomind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/seomind"
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seomind"

# SQLite Fallback (Used if PostgreSQL is not available locally for rapid dev/test)
USE_SQLITE_FALLBACK=True
SQLITE_DATABASE_URL="sqlite+aiosqlite:///./seomind.db"

# LLM Configuration (Groq API)
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-20b"

# Persistent Memory Layer (Hindsight by Vectorize)
HINDSIGHT_API_URL="https://api.hindsight.vectorize.io"
HINDSIGHT_API_KEY="hsk_your_hindsight_api_key_here"
HINDSIGHT_TIMEOUT_SECONDS=10.0

# Crawler Configuration
CRAWL_MAX_PAGES=15
CRAWL_TIMEOUT_SECONDS=10.0
